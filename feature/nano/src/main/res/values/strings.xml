    <!-- Intro -->
    <string name="nano_intro_title">On-device AI (Gemini Nano)</string>
    <string name="nano_intro_body">Gemini Nano is Google\'s smallest model — it runs entirely on the device, with no
        network round-trip. Support is checked at runtime through ML Kit\'s on-device GenAI APIs, which
        are all powered by Gemini Nano.</string>

